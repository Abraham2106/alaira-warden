WARDEN_ENV=development
# Legacy shared token is rejected by the individual identity mode.
# Sign in with a credential issued by scripts/provision_identity.py instead.
WARDEN_API_TOKEN=
# Individual credentials are issued by scripts/provision_identity.py.
WARDEN_IDENTITY_PEPPER=
WARDEN_DATABASE_URL=postgresql://warden_app:local_app_only_change_me@localhost:5432/warden
WARDEN_MIGRATION_DATABASE_URL=postgresql://warden_owner:local_owner_only_change_me@localhost:5432/warden
POSTGRES_PASSWORD=local_owner_only_change_me
WARDEN_DB_APP_PASSWORD=local_app_only_change_me
WARDEN_HTTP_PORT=8000
WARDEN_DB_PORT=5432
LANGSMITH_TRACING=false
# Optional: base OTLP/HTTP endpoint of a trusted local collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=alaira-warden

# Connector credentials (optional). A non-empty value is only a reference:
# adapters stay not_implemented and unverified until a real call succeeds.
WARDEN_GITHUB_TOKEN=
WARDEN_NVD_API_KEY=
# Nightshift hotspot (Meterless Runtime). Token is <stateDir>/proxy-token.
# Reject rt-local. An empty token stays unconfigured. The example URL is not a live runtime.
# NVIDIA/Nemotron keys go in Nightshift Providers, never here.
# Inside the API container, loopback is rewritten to host.docker.internal when /.dockerenv exists.
WARDEN_METERLESS_API_KEY=
WARDEN_METERLESS_BASE_URL=http://127.0.0.1:8088/v1
WARDEN_METERLESS_MODEL=meterless/auto
WARDEN_MODEL_DISPATCH_POLICY=deny
WARDEN_GROK_API_KEY=
WARDEN_ZETARIS_API_KEY=
# Local UI origin. The bundled instance serves the SQL proxy on this host, not the raw API port.
WARDEN_ZETARIS_BASE_URL=http://127.0.0.1:3000
WARDEN_ZETARIS_ORG_ID=
WARDEN_ZETARIS_USERNAME=
WARDEN_ZETARIS_PASSWORD=
# Local integration mode is not sponsor compliance. Zetaris mode fails closed.
WARDEN_DATA_MODE=local
WARDEN_ZETARIS_INVENTORY_TABLE=warden_pg.warden_inventory_data
WARDEN_ZETARIS_EVIDENCE_TABLE=warden_pg.warden_evidence_data
# Optional JSON persist dir for H-MEM. PostgreSQL snapshot is the product default.
WARDEN_HMEM_PERSIST_DIR=
WARDEN_CURSOR_API_KEY=

# Guided demo (POST /api/demo/run or: uv run python scripts/demo_agents.py)
# Does not read these sponsor keys. Nightshift/Zetaris/NVIDIA stay uncontacted.
# Swap the labeled mock for a real Nightshift client by setting the Meterless
# variables above and keeping WARDEN_MODEL_DISPATCH_POLICY=allow_minimized.

# Trusted offline tool image, resolved by docker image inspect after building.
WARDEN_REMEDIATION_IMAGE=
WARDEN_REPOSITORY_ROOT=artifacts/repositories
WARDEN_EXECUTION_ROOT=artifacts/execution
